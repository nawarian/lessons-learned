# Lessons Learned — browse the course in your browser.
#
#   make            build the index and open it (default)
#   make open       same as above
#   make index      (re)generate index.html from lessons/ + reference/
#   make lessons    open every lesson in its own tab, in order
#   make clean      remove the generated index.html
#   make help       show this list

BROWSER ?= xdg-open
LESSONS := $(sort $(wildcard lessons/*.html))
REFS    := $(sort $(wildcard reference/*.html))
INDEX   := index.html

.DEFAULT_GOAL := open

.PHONY: open index lessons clean help

open: $(INDEX)
	@$(BROWSER) $(INDEX) >/dev/null 2>&1 &

index: $(INDEX)

$(INDEX): $(LESSONS) $(REFS) Makefile
	@echo "building $@ ..."
	@{ \
	  echo '<!DOCTYPE html><html lang="en" data-theme=""><head>'; \
	  echo '<meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1">'; \
	  echo '<title>Lessons Learned · Index</title>'; \
	  echo '<link rel="stylesheet" href="assets/lesson.css"></head><body>'; \
	  echo '<p class="kicker">Index</p><h1>Lessons Learned</h1>'; \
	  echo '<p class="subtitle">GPT Training &mdash; from scratch to fine-tuning.</p>'; \
	  echo '<h2>Lessons</h2><ol>'; \
	  for f in $(LESSONS); do \
	    t=$$(sed -n 's:.*<title>\(.*\)</title>.*:\1:p' "$$f" | head -1); \
	    echo "<li style=\"margin:.4rem 0\"><a href=\"$$f\">$$t</a></li>"; \
	  done; \
	  echo '</ol><h2>Reference</h2><ul>'; \
	  for f in $(REFS); do \
	    t=$$(sed -n 's:.*<title>\(.*\)</title>.*:\1:p' "$$f" | head -1); \
	    echo "<li style=\"margin:.4rem 0\"><a href=\"$$f\">$$t</a></li>"; \
	  done; \
	  echo '</ul>'; \
	  echo '<p class="note">Generated by <code>make index</code>. Edit lessons, not this file.</p>'; \
	  echo '</body></html>'; \
	} > $@

lessons:
	@for f in $(LESSONS); do $(BROWSER) "$$f" >/dev/null 2>&1 & done

clean:
	@rm -f $(INDEX)

help:
	@sed -n 's/^# \{0,1\}//p; /^[^#]/q' $(MAKEFILE_LIST)
